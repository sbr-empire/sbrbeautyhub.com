# ============================================================================
# SBR BEAUTY HUB - ENVIRONMENT CONFIGURATION
# ============================================================================

# React App
REACT_APP_SBCORE_API=https://sbr-core-api.run.app
REACT_APP_API_BASE_URL=https://sbr-core-api.run.app
REACT_APP_ENV=production

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# ============================================================================
# STRIPE PAYMENT
# ============================================================================
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key
REACT_APP_STRIPE_SECRET_KEY=your_stripe_secret_key

# ============================================================================
# GOOGLE CLOUD
# ============================================================================
REACT_APP_GCP_PROJECT_ID=your_gcp_project_id

# ============================================================================
# APP SETTINGS
# ============================================================================
REACT_APP_COMMISSION_RATE=0.15
REACT_APP_MAX_UPLOAD_SIZE=10485760
REACT_APP_IMAGE_QUALITY=0.8
